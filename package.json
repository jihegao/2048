{
  "name": "2048-challenge-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "i18n:check": "node scripts/check-i18n.mjs",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:e2e": "playwright test",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply challenge-platform --local",
    "db:migrate:remote": "wrangler d1 migrations apply challenge-platform --remote",
    "deploy": "wrangler deploy",
    "smoke:online": "node scripts/online-smoke.mjs",
    "check": "npm run cf-typegen && npm run format:check && npm run lint && npm run i18n:check && npm run typecheck && npm run test:unit && npm run test:worker && npm run build"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.0",
    "exceljs": "^4.4.0",
    "hono": "^4.13.5",
    "i18next": "^26.4.0",
    "papaparse": "^5.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.12",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.0",
    "@cloudflare/workers-types": "^5.20260826.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^25.0.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.3.0",
    "prettier": "^3.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.126.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
